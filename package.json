{
  "name": "@keenmate/web-dropzone-monorepo",
  "private": true,
  "version": "1.0.0-rc03",
  "description": "Monorepo for @keenmate/web-dropzone (renderer + custom elements) and @keenmate/web-dropzone-core (headless store).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build -ws --if-present",
    "build:core": "npm run build -w @keenmate/web-dropzone-core",
    "build:renderer": "npm run build -w @keenmate/web-dropzone",
    "build:examples": "vite build --mode examples",
    "preview:examples": "vite preview --mode examples",
    "clean:dist": "npm run clean -ws --if-present",
    "clean": "npm run clean -ws --if-present && rimraf dist-examples node_modules/.vite",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:unit -w @keenmate/web-dropzone",
    "test:unit:watch": "npm run test:unit:watch -w @keenmate/web-dropzone",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "doctor": "kmwc doctor",
    "check:vars": "kmwc check-vars",
    "check:pages": "kmwc check-pages"
  },
  "author": "Keenmate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenmate/web-dropzone.git"
  },
  "homepage": "https://github.com/keenmate/web-dropzone#readme",
  "bugs": {
    "url": "https://github.com/keenmate/web-dropzone/issues"
  },
  "kmwc": {
    "id": "web-dropzone",
    "title": "Web Dropzone",
    "tagline": "File upload web component with drag-drop, previews, validation, and multiple display modes",
    "tag": "web-dropzone",
    "prefix": "dz",
    "library": {
      "shouldBuild": false,
      "entry": "packages/web-dropzone/src/index.ts"
    },
    "ports": {
      "dev": 12500,
      "image": 12510
    },
    "theme": {
      "accentColor": "#667eea",
      "accentEndColor": "#764ba2"
    },
    "analytics": {
      "plausibleSiteId": "pa-dvZF3eSW2ZTof8_N7gKC8"
    },
    "image": {
      "name": "registry.km8.es/web-dropzone-examples:prod",
      "runner": "podman",
      "packageJsonPaths": [
        "package.json",
        "packages/web-dropzone/package.json",
        "packages/web-dropzone-core/package.json"
      ]
    },
    "cssVariables": {
      "sources": [
        "packages/web-dropzone/src/css"
      ],
      "manifest": "packages/web-dropzone/component-variables.manifest.json"
    }
  },
  "devDependencies": {
    "@keenmate/web-components-devkit": "^1.0.0-rc10",
    "@playwright/test": "^1.60.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vite": "^7.3.7"
  }
}
